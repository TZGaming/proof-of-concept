<section class="reviews">
  <h1 id="reviews">Reviews</h1>

  <span class="final-rating">5.0</span>
  <span>out of 5</span><br><br>

  <button class="add-review-button" type="button">Add your review</button>

  <form class="add-review-section" method="POST" action="/reviews">
    <input type="text" id="title-input" name="title" placeholder="Title..." class="review-input" required>
    <textarea id="description-input" name="description" placeholder="Description..." class="review-input-description" required></textarea>

    <div class="criteria-rating-list">
      <div class="criteria-rating-row">
        <span class="criteria-label">Grip</span>
        <div class="star-rating" role="radiogroup" aria-label="Grip rating">
          {% for i in (1..5) reversed %}
            <input type="radio" id="grip-rating-{{ i }}" name="grip" value="{{ i }}" required>
            <label for="grip-rating-{{ i }}" class="star" aria-label="{{ i }} star{% if i != 1 %}s{% endif %}">
              <svg width="18" height="18" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3.8042 0L4.70226 2.76393H7.60843L5.25728 4.47214L6.15534 7.23607L3.8042 5.52786L1.45306 7.23607L2.35111 4.47214L-2.69413e-05 2.76393H2.90614L3.8042 0Z" fill="currentColor"/>
              </svg>
            </label>
          {% endfor %}
        </div>
      </div>
      <div class="criteria-rating-row">
        <span class="criteria-label">Foot support</span>
        <div class="star-rating" role="radiogroup" aria-label="Foot support rating">
          {% for i in (1..5) reversed %}
            <input type="radio" id="foot-support-rating-{{ i }}" name="foot_support" value="{{ i }}" required>
            <label for="foot-support-rating-{{ i }}" class="star" aria-label="{{ i }} star{% if i != 1 %}s{% endif %}">
              <svg width="18" height="18" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3.8042 0L4.70226 2.76393H7.60843L5.25728 4.47214L6.15534 7.23607L3.8042 5.52786L1.45306 7.23607L2.35111 4.47214L-2.69413e-05 2.76393H2.90614L3.8042 0Z" fill="currentColor"/>
              </svg>
            </label>
          {% endfor %}
        </div>
      </div>
      <div class="criteria-rating-row">
        <span class="criteria-label">Lightweight</span>
        <div class="star-rating" role="radiogroup" aria-label="Lightweight rating">
          {% for i in (1..5) reversed %}
            <input type="radio" id="lightweight-rating-{{ i }}" name="lightweight" value="{{ i }}" required>
            <label for="lightweight-rating-{{ i }}" class="star" aria-label="{{ i }} star{% if i != 1 %}s{% endif %}">
              <svg width="18" height="18" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3.8042 0L4.70226 2.76393H7.60843L5.25728 4.47214L6.15534 7.23607L3.8042 5.52786L1.45306 7.23607L2.35111 4.47214L-2.69413e-05 2.76393H2.90614L3.8042 0Z" fill="currentColor"/>
              </svg>
            </label>
          {% endfor %}
        </div>
      </div>
      <div class="criteria-rating-row">
        <span class="criteria-label">Value for money</span>
        <div class="star-rating" role="radiogroup" aria-label="Value for money rating">
          {% for i in (1..5) reversed %}
            <input type="radio" id="value-for-money-rating-{{ i }}" name="value_for_money" value="{{ i }}" required>
            <label for="value-for-money-rating-{{ i }}" class="star" aria-label="{{ i }} star{% if i != 1 %}s{% endif %}">
              <svg width="18" height="18" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3.8042 0L4.70226 2.76393H7.60843L5.25728 4.47214L6.15534 7.23607L3.8042 5.52786L1.45306 7.23607L2.35111 4.47214L-2.69413e-05 2.76393H2.90614L3.8042 0Z" fill="currentColor"/>
              </svg>
            </label>
          {% endfor %}
        </div>
      </div>
      <div class="criteria-rating-row">
        <span class="criteria-label">Look / design</span>
        <div class="star-rating" role="radiogroup" aria-label="Look and design rating">
          {% for i in (1..5) reversed %}
            <input type="radio" id="look-design-rating-{{ i }}" name="look_design" value="{{ i }}" required>
            <label for="look-design-rating-{{ i }}" class="star" aria-label="{{ i }} star{% if i != 1 %}s{% endif %}">
              <svg width="18" height="18" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3.8042 0L4.70226 2.76393H7.60843L5.25728 4.47214L6.15534 7.23607L3.8042 5.52786L1.45306 7.23607L2.35111 4.47214L-2.69413e-05 2.76393H2.90614L3.8042 0Z" fill="currentColor"/>
              </svg>
            </label>
          {% endfor %}
        </div>
      </div>
    </div>

    <h3>Overall rating:</h3>
    <div class="star-rating" role="radiogroup" aria-label="Review rating">
      {% for i in (1..5) reversed %}
        <input type="radio" id="rating-{{ i }}" name="rating" value="{{ i }}" required>
        <label for="rating-{{ i }}" class="star" aria-label="{{ i }} star{% if i != 1 %}s{% endif %}">
          <svg width="18" height="18" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3.8042 0L4.70226 2.76393H7.60843L5.25728 4.47214L6.15534 7.23607L3.8042 5.52786L1.45306 7.23607L2.35111 4.47214L-2.69413e-05 2.76393H2.90614L3.8042 0Z" fill="currentColor"/>
          </svg>
        </label>
      {% endfor %}
    </div>

    <button class="submit-review-button" type="submit">Submit</button>
  </form>

  <div class="customer-reviews">
    {% assign reviews = reviews | reverse %}
    {% for review in reviews %}
      <article id="review-{{ review.id }}" class="review-item">
        <div class="review-stars">
          {% for i in (1..review.ratingValue) %}
            <svg width="14" height="14" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3.8042 0L4.70226 2.76393H7.60843L5.25728 4.47214L6.15534 7.23607L3.8042 5.52786L1.45306 7.23607L2.35111 4.47214L-2.69413e-05 2.76393H2.90614L3.8042 0Z" fill="black"/>
            </svg>
          {% endfor %}
        </div>
          <h1 class="review-title">{{ review.title }}</h1>
          <p>{{ review.description }}</p>

          {% for attribute in review.attributes %}
            <ul class="review-attributes">
              <li>
                <span class="score">{{ attribute.score }}/5
                  <svg width="14" height="14" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3.8042 0L4.70226 2.76393H7.60843L5.25728 4.47214L6.15534 7.23607L3.8042 5.52786L1.45306 7.23607L2.35111 4.47214L-2.69413e-05 2.76393H2.90614L3.8042 0Z" fill="black"/>
                  </svg>
                </span>
                <span class="criteria">{{ attribute.criteria }}</span>
              </li>
            </ul>
          {% endfor %}

          {% if review.verified_buyer == true %}
            <p class="review-information">{{ review.name }}, {{ review.location }} | Verified buyer | {{ review.created_at | relative_time }}</p>
          {% else %}
            <p class="review-information">{{ review.name }}, {{ review.location }} | {{ review.created_at | relative_time }}</p>
          {% endif %}
      </article>
    {% endfor %}
  </div>
</section>

<script>
  let reviewButton = document.querySelector('.add-review-button');
  let reviewSection = document.querySelector('.add-review-section');

  reviewSection.classList.add('hidden');

  reviewButton.addEventListener('click', () => {
    reviewSection.classList.toggle('hidden');
  });
</script>
</main>